# ========================================================
# NeuroTrust Production Deployment Environment Variables
# ========================================================

# Groq LLM API
GROQ_API_KEY=your_groq_api_key_here
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b

# Alpaca API Credentials (Paper or Live)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_PAPER=true
ALPACA_DATA_FEED=iex

# Risk Guardrails
MAX_ORDER_VALUE=5000.0
MAX_POSITION_SIZE=10000.0

# Frontend Gateway URL (Public domain or IP if deploying to cloud)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
