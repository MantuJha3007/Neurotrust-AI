# API server
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8001
CORS_ORIGINS=http://localhost:3000

# Groq
# Current Groq structured-output capable models include GPT-OSS and Qwen 3.8.
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_RETRIES=4
GROQ_TEMPERATURE=0

# Alpaca - use PAPER credentials while developing
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
# Alpaca feed: iex for the basic equity feed; use your entitled feed when applicable.
ALPACA_DATA_FEED=iex

# Agent safety limits
AGENT_DEFAULT_MODE=paper
AGENT_MAX_POSITION_RISK=850
AGENT_DAILY_LOSS_LIMIT=2000
AGENT_MAX_EXPOSURE_PERCENT=90
AGENT_LOOP_SECONDS=60

# Market watchlist returned by /api/market/quotes
WATCHLIST=SPY,AAPL,NVDA,QQQ

# MCP
MCP_SERVER_NAME=ai-trading-agent-mcp
MCP_TRANSPORT=stdio

# Local state
SQLITE_PATH=./data/trading_agent.db
